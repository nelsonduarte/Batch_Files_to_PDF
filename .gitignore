# Virtual environments
venv/
.venv/
env/

# Bytecode: was committed by accident once, including stale 3.10/3.14 builds.
__pycache__/
*.pyc
*.pyo

# PDFs the tool writes next to the sources it converts. Without this, a test
# run inside the working tree would offer every generated PDF up for commit.
*.pdf

# Credentials and local configuration. Nothing here reads them, but a stray
# .env in the working tree must never be one `git add -A` away from a public
# repository.
.env
.env.*
*.pem
*.key
*.pfx
credentials.json
secrets.*

# Editors and OS clutter
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test and tooling output
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
